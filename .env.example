# Copiez ce fichier en .env puis renseignez vos valeurs. Ne committez jamais .env.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
POSTGRES_URL=
ANTHROPIC_API_KEY=
NTFY_TOPIC=

# --- Sécurité (facultatif en local, recommandé dès qu'un tiers teste l'application) ---
# Code d'accès demandé par l'application (vide = aucun)
ACCESS_CODE=
# Origines autorisées par le CORS, séparées par des virgules (défaut : l'application elle-même)
CORS_ORIGINS=
# Mot de passe PostgreSQL de DataSwipe et mot de passe admin Airflow (défauts de développement si vides)
DATASWIPE_DB_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
